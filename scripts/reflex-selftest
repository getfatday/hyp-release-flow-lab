#!/usr/bin/env python3
"""reflex-selftest — install-time end-to-end drill for the reflex wiring (H-254).

The variable under test. Runs as the FINAL step of the reflex plugin install
path (install.sh finalize-on) and refuses to let an install count as done
unless the whole breach pipeline is PROVEN on this machine, cold:

  wiring checks (named):    timer-entry | session-hook | collector | row-path
  drill (seeded scratch):   synthetic breaches (P1 backdated chain-terminal,
                            P2 quiet lane per the H-154 recipe, P5 backdated
                            mute) -> timer-simulated sensor ticks -> fire ->
                            edge dedupe -> hook tick -> collector -> incident
                            dir -> H-104 manifest verify + anchors lint ->
                            validated needs-ian row (decisions.py door) ->
                            escalation at exactly the third simulated surfacing.

Loud-failure grammar (frozen): on any broken element this exits non-zero and
prints exactly one line
    SELFTEST-FAIL element=<element> detail=<what is missing/broken>
naming the wiring element — the S2 failure class ("the detector was never
actually installed") becomes a loud exit code at install time. On success:
    SELFTEST-OK checks=<n> duration=<s>

Containment: writes ONLY under <root>/.claude/reflex/ (its selftest scratch
and the sensor state the drill produces live in the drill fixture inside it).
The emitted launchd plist is read and lint-checked, NEVER loaded (H-217/H-251
law). Anti-clog C2: zero work-ledger rows outside the drill scratch — the
drill's decision row lands in the DRILL's own ledger, never the host repo's.
Bound: the whole self-test must finish within 120 s (self-enforced + reported).

Usage: reflex-selftest --root <repo> [--now EPOCH]
Exit 0 proven; 1 SELFTEST-FAIL (element named); 2 usage.
Stdlib only; zero LLM; zero network.
"""
import argparse
import datetime
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import time

TICK_S = 1800
BOUND_S = 120.0
N_ESCALATE = 3
PLIST_NAME = "com.minilab.reflex-check.plist"
EXPECTED_FIRES = {("P1", "H-901/chain-terminal.run1"),
                  ("P2", "H-902"),
                  ("P5", ".claude/stop-snooze")}
UTC = datetime.timezone.utc

T0 = time.monotonic()
CHECKS = []          # [{name, ok, detail}]
STATE = {}           # accumulates report fields


def iso_z(epoch):
    return datetime.datetime.fromtimestamp(
        int(epoch), UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def report_path(root):
    return os.path.join(root, ".claude", "reflex", "selftest", "report.json")


def write_report(root, status, element=None, detail=None):
    rec = {"schema": "reflex-selftest/v1", "status": status,
           "element": element, "detail": detail,
           "checks": CHECKS, "duration_s": round(time.monotonic() - T0, 3)}
    rec.update(STATE)
    path = report_path(root)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(rec, fh, indent=1, sort_keys=True)


def fail(root, element, detail):
    CHECKS.append({"name": element, "ok": False, "detail": detail})
    write_report(root, "fail", element, detail)
    print("SELFTEST-FAIL element=%s detail=%s" % (element, detail))
    sys.exit(1)


def ok(name, detail=""):
    CHECKS.append({"name": name, "ok": True, "detail": detail})
    print("SELFTEST-CHECK %s ok%s" % (name, (" (%s)" % detail) if detail else ""))


def run(cmd, log_path, timeout, env=None):
    e = dict(os.environ)
    if env:
        e.update(env)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True,
                           timeout=timeout, env=e)
        out = (r.stdout or "") + (r.stderr or "")
        rc = r.returncode
    except subprocess.TimeoutExpired as ex:
        out = "TIMEOUT after %ss: %s" % (timeout, ex)
        rc = -9
    with open(log_path, "w", encoding="utf-8") as fh:
        fh.write("cmd: %s\nrc: %s\n---\n%s" % (" ".join(map(str, cmd)), rc, out))
    return rc, out


def git_drill(cwd, *args, env=None):
    e = dict(os.environ)
    e.update({"GIT_AUTHOR_NAME": "reflex-selftest",
              "GIT_AUTHOR_EMAIL": "reflex-selftest@local",
              "GIT_COMMITTER_NAME": "reflex-selftest",
              "GIT_COMMITTER_EMAIL": "reflex-selftest@local",
              "GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "commit.gpgsign",
              "GIT_CONFIG_VALUE_0": "false"})
    if env:
        e.update(env)
    return subprocess.run(["git", "-C", cwd] + list(args), capture_output=True,
                          text=True, timeout=60, env=e)


def load_module(path, name):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


# ---------- wiring checks (each failure names its element) ----------

def check_timer_entry(root):
    plist = os.path.join(root, ".claude", "reflex", "launchagents", PLIST_NAME)
    rel = os.path.relpath(plist, root)
    if not os.path.isfile(plist):
        fail(root, "timer-entry", "timer plist absent at %s — no timer entry "
             "means the sensor never runs cold (S2)" % rel)
    r = subprocess.run(["/usr/bin/plutil", "-lint", "-s", plist],
                       capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        fail(root, "timer-entry", "plist fails plutil lint: %s"
             % (r.stdout + r.stderr).strip())
    r = subprocess.run(["/usr/bin/plutil", "-convert", "json", "-o", "-", plist],
                       capture_output=True, text=True, timeout=30)
    try:
        prog = json.loads(r.stdout)["ProgramArguments"]
    except (ValueError, KeyError):
        fail(root, "timer-entry", "plist carries no ProgramArguments")
    if len(prog) < 2 or not os.path.isfile(prog[1]) \
            or not os.access(prog[1], os.X_OK):
        fail(root, "timer-entry", "plist points at a missing/non-executable "
             "sensor: %s" % (prog[1:2] or ["<none>"])[0])
    ok("timer-entry", "plist linted; sensor path resolves; NEVER loaded")
    return prog


def check_session_hook(root):
    spath = os.path.join(root, ".claude", "settings.json")
    registered = False
    try:
        settings = json.load(open(spath, encoding="utf-8"))
        for entry in settings.get("hooks", {}).get("SessionStart", []):
            for h in entry.get("hooks", []):
                if "reflex-sessionstart.sh" in str(h.get("command", "")):
                    registered = True
    except (OSError, ValueError):
        pass
    if not registered:
        fail(root, "session-hook", "no SessionStart registration for "
             "reflex-sessionstart.sh in .claude/settings.json — the sensor "
             "never runs at session boundaries")
    hook = os.path.join(root, "hooks", "reflex-sessionstart.sh")
    if not os.path.isfile(hook) or not os.access(hook, os.X_OK):
        fail(root, "session-hook", "hooks/reflex-sessionstart.sh absent or "
             "not executable")
    ok("session-hook", "registered in settings.json; hook script executable")
    return hook


def check_collector(root):
    col = os.path.join(root, "scripts", "reflex-collect")
    if not os.path.isfile(col) or not os.access(col, os.X_OK):
        fail(root, "collector", "scripts/reflex-collect absent — breaches "
             "would fire with no autopsy (S2)")
    for dep in ("fidelity-manifest.py", "incident-anchors-lint.py"):
        if not os.path.isfile(os.path.join(root, "scripts", dep)):
            fail(root, "collector", "scripts/%s absent (collector manifest/"
                 "lint leg unwired)" % dep)
    ok("collector", "reflex-collect + manifest + anchors-lint present")
    return col


def check_row_path(root):
    dpath = os.path.join(root, "scripts", "decisions.py")
    if not os.path.isfile(dpath):
        fail(root, "row-path", "scripts/decisions.py absent — the decision "
             "door is not wired; validated rows cannot land")
    try:
        D = load_module(dpath, "selftest_decisions")
    except Exception as ex:
        fail(root, "row-path", "decisions.py failed to import: %r" % (ex,))
    for prim in ("validate_decision", "append_line", "parse_ledger_v3",
                 "read_ledger", "next_free_id"):
        if not hasattr(D, prim):
            fail(root, "row-path", "decisions.py lacks the %s primitive" % prim)
    if not os.path.isfile(os.path.join(root, "ledger", "work-ledger.jsonl")):
        fail(root, "row-path", "ledger/work-ledger.jsonl absent")
    ok("row-path", "decisions.py door importable; ledger present")
    return D


# ---------- the drill ----------

def build_drill(root, st_dir, now):
    """Seed the scratch fixture: P1 backdated chain-terminal, P2 quiet lane
    (H-154 recipe), P5 backdated mute. Frontier stays empty (both active specs
    own run dirs) so P3 stays quiet; the drill ledger starts empty so P4 stays
    quiet — expected fires are exactly P1+P2+P5."""
    drill = os.path.join(st_dir, "drill")
    os.makedirs(os.path.join(drill, "hypotheses"))
    for lane in ("H-901", "H-902"):
        os.makedirs(os.path.join(drill, "experiments", "runs", lane))
    os.makedirs(os.path.join(drill, "ledger"))
    os.makedirs(os.path.join(drill, ".claude"))
    with open(os.path.join(drill, "hypotheses", "H-901-drill-p1-lane.md"), "w") as fh:
        fh.write("# H-901 drill p1 lane\n\n## Status\nactive\n")
    with open(os.path.join(drill, "hypotheses", "H-902-drill-quiet-lane.md"), "w") as fh:
        fh.write("# H-902 drill quiet lane\n\n## Status\nactive\n")
    open(os.path.join(drill, "ledger", "work-ledger.jsonl"), "w").close()
    with open(os.path.join(drill, "experiments", "runs", "H-901",
                           "RUN-CLAIM.json"), "w") as fh:
        fh.write('{"lane": "H-901", "claim": "drill"}\n')
    with open(os.path.join(drill, "experiments", "runs", "H-902",
                           "notes.md"), "w") as fh:
        fh.write("drill quiet lane scaffold\n")
    r = git_drill(drill, "init", "-q")
    if r.returncode != 0:
        raise RuntimeError("git init failed: %s" % r.stderr)
    git_drill(drill, "add", "-A")
    backdate = "@%d +0000" % int(now - 5 * 86400)
    r = git_drill(drill, "commit", "-q", "-m", "drill scaffold",
                  env={"GIT_AUTHOR_DATE": backdate, "GIT_COMMITTER_DATE": backdate})
    if r.returncode != 0:
        raise RuntimeError("git commit failed: %s" % r.stderr)
    # seeds (untracked; mtimes carry the breach ages)
    p1 = os.path.join(drill, "experiments", "runs", "H-901", "chain-terminal.run1")
    with open(p1, "w") as fh:
        fh.write("0\n")
    os.utime(p1, (now - 3 * TICK_S, now - 3 * TICK_S))
    quiet = os.path.join(drill, "experiments", "runs", "H-902", "chain-log.txt")
    with open(quiet, "w") as fh:
        fh.write("drill quiet lane last touch\n")
    os.utime(quiet, (now - 4 * 86400, now - 4 * 86400))
    mute = os.path.join(drill, ".claude", "stop-snooze")
    with open(mute, "w") as fh:
        fh.write("drill mute\n")
    os.utime(mute, (now - 3 * TICK_S, now - 3 * TICK_S))
    # backdate the committed scaffolding too (checkout mtimes are 'now')
    for rel, age in (("experiments/runs/H-901/RUN-CLAIM.json", 3 * TICK_S),
                     ("experiments/runs/H-902/notes.md", 4 * 86400),
                     ("hypotheses/H-901-drill-p1-lane.md", 5 * 86400),
                     ("hypotheses/H-902-drill-quiet-lane.md", 5 * 86400),
                     ("ledger/work-ledger.jsonl", 5 * 86400)):
        p = os.path.join(drill, rel)
        os.utime(p, (now - age, now - age))
    return drill


def read_fires(drill):
    path = os.path.join(drill, ".claude", "reflex", "breaches.jsonl")
    fires = []
    if os.path.isfile(path):
        for line in open(path, encoding="utf-8"):
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except ValueError:
                continue
            fires.append((rec.get("predicate"), rec.get("subject")))
    return fires


def build_estate(root, st_dir, drill, now):
    """Estate contract v1 (frozen in the H-252 fixture.lock) synthesized from
    the drill so the kept collector runs over drill evidence."""
    estate = os.path.join(st_dir, "estate")
    for d in ("repo/ledger", "repo/.claude", "repo/hooks-log",
              "repo/experiments/runs/H-901",
              "repo/experiments/runs/DESIGN-post-010-train",
              "jobs/children", "launchagents"):
        os.makedirs(os.path.join(estate, d))
    r = git_drill(drill, "log", "--format=%h %ad %s", "--date=iso-strict")
    with open(os.path.join(estate, "repo", "gitlog-window.txt"), "w") as fh:
        fh.write(r.stdout)
    shutil.copy2(os.path.join(drill, "ledger", "work-ledger.jsonl"),
                 os.path.join(estate, "repo", "ledger", "work-ledger.jsonl"))
    shutil.copy2(os.path.join(drill, ".claude", "stop-snooze"),
                 os.path.join(estate, "repo", ".claude", "stop-snooze"))
    with open(os.path.join(estate, "repo", "harden-cache-snapshot.txt"), "w") as fh:
        fh.write("harden-last: clean (drill synthetic estate)\n")
    with open(os.path.join(estate, "repo", "hooks-log",
                           "stop-driver-hook-log.jsonl"), "w") as fh:
        fh.write(json.dumps({"ts": int(now - 2 * TICK_S), "decision": "allow",
                             "reason": "drill synthetic estate"}) + "\n")
    shutil.copy2(os.path.join(drill, "experiments", "runs", "H-901",
                              "chain-terminal.run1"),
                 os.path.join(estate, "repo", "experiments", "runs", "H-901",
                              "chain-terminal.run1"))
    with open(os.path.join(estate, "repo", "experiments", "runs",
                           "DESIGN-post-010-train", "wave-plan.json"), "w") as fh:
        fh.write('{"waves": []}\n')
    with open(os.path.join(estate, "repo", "spec-status.tsv"), "w") as fh:
        fh.write("H-901\tactive\nH-902\tactive\n")
    with open(os.path.join(estate, "jobs", "queue-runner8.log"), "w") as fh:
        fh.write("%s drill queue line 1\n%s drill queue line 2\n"
                 % (iso_z(now - 3 * TICK_S), iso_z(now - TICK_S)))
    with open(os.path.join(estate, "jobs", "children",
                           "drill-child.jsonl"), "w") as fh:
        fh.write(json.dumps({"ts": iso_z(now - TICK_S), "type": "note",
                             "text": "drill child strip"}) + "\n")
    src_plist = os.path.join(root, ".claude", "reflex", "launchagents", PLIST_NAME)
    shutil.copy2(src_plist, os.path.join(estate, "launchagents", PLIST_NAME))
    r = git_drill(estate, "init", "-q")
    if r.returncode != 0:
        raise RuntimeError("estate git init failed: %s" % r.stderr)
    git_drill(estate, "add", "-A")
    r = git_drill(estate, "commit", "-q", "-m", "drill estate snapshot")
    if r.returncode != 0:
        raise RuntimeError("estate git commit failed: %s" % r.stderr)
    return estate


def main():
    ap = argparse.ArgumentParser(prog="reflex-selftest")
    ap.add_argument("--root", required=True)
    ap.add_argument("--now", type=float, default=None)
    args = ap.parse_args()
    root = os.path.abspath(args.root)
    now = args.now if args.now is not None else time.time()
    STATE["now"] = int(now)

    st_dir = os.path.join(root, ".claude", "reflex", "selftest")
    if os.path.isdir(st_dir):
        shutil.rmtree(st_dir)
    logs = os.path.join(st_dir, "logs")
    os.makedirs(logs)

    # ---- wiring checks (the sabotage matrix's named elements) ----
    prog = check_timer_entry(root)
    hook = check_session_hook(root)
    check_collector(root)
    D = check_row_path(root)

    # ---- drill: seeded scratch fixture ----
    try:
        drill = build_drill(root, st_dir, now)
    except Exception as ex:
        fail(root, "drill-build", "could not build the drill fixture: %r" % (ex,))

    # tick 1: the timer path, exactly as the plist would run it (root swapped
    # to the drill, --now pinned; the plist itself is NEVER loaded)
    tick_cmd = [prog[0], prog[1], "--root", drill, "--now", str(int(now)),
                "--trigger", "timer"]
    rc, _ = run(tick_cmd, os.path.join(logs, "tick1.out"), 90)
    fires = read_fires(drill)
    if rc != 0 or set(fires) != EXPECTED_FIRES or len(fires) != 3:
        fail(root, "drill-fire", "seeded breaches did not fire (rc=%s, fires=%s;"
             " expected P1+P2+P5) — the sensor ran but produced no real "
             "breach artifact" % (rc, sorted(fires)))
    STATE["fires"] = sorted("%s|%s" % f for f in fires)
    ok("drill-fire", "P1+P2+P5 fired on the seeded scratch")

    # tick 2: edge dedupe — standing breaches must not re-fire
    tick2 = [prog[0], prog[1], "--root", drill, "--now", str(int(now + TICK_S)),
             "--trigger", "timer"]
    rc, _ = run(tick2, os.path.join(logs, "tick2.out"), 90)
    if rc != 0 or len(read_fires(drill)) != 3:
        fail(root, "drill-edge", "standing breaches re-fired on tick 2 "
             "(edge-triggered dedupe broken; fires=%d)" % len(read_fires(drill)))
    ok("drill-edge", "no re-fire on the standing breach")

    # hook tick: the session-start wiring end-to-end
    rc, _ = run(["/bin/bash", hook], os.path.join(logs, "hook.out"), 90,
                env={"REFLEX_ROOT": drill,
                     "REFLEX_NOW": str(int(now + 2 * TICK_S))})
    inv = os.path.join(drill, ".claude", "reflex", "invocations.jsonl")
    seen_session = False
    if os.path.isfile(inv):
        for line in open(inv, encoding="utf-8"):
            try:
                if json.loads(line).get("trigger") == "session-start":
                    seen_session = True
            except ValueError:
                continue
    if rc != 0 or not seen_session:
        fail(root, "drill-hook", "session-start hook ran without landing an "
             "invocation line (rc=%s)" % rc)
    ok("drill-hook", "hook tick landed its invocation line")

    # collector: incident dir + H-104 manifest verify, over a drill estate
    try:
        estate = build_estate(root, st_dir, drill, now)
    except Exception as ex:
        fail(root, "drill-collect", "could not build the drill estate: %r" % (ex,))
    inc_out = os.path.join(st_dir, "incidents")
    col_now = iso_z(now + 2 * TICK_S)
    rc, out = run([sys.executable, os.path.join(root, "scripts", "reflex-collect"),
                   "--root", estate, "--now", col_now,
                   "--breach", "reflex-selftest-drill", "--out", inc_out,
                   "--worker-timeout", "60"],
                  os.path.join(logs, "collect.out"), 100)
    incs = sorted(d for d in (os.listdir(inc_out) if os.path.isdir(inc_out) else [])
                  if d.startswith("INC-"))
    inc = os.path.join(inc_out, incs[0]) if incs else None
    if rc != 0 or inc is None \
            or not os.path.isfile(os.path.join(inc, "COLLECTED.md")) \
            or not os.path.isfile(os.path.join(inc, "incident.json")):
        fail(root, "drill-collect", "collector did not land a complete incident "
             "record (rc=%s, incident=%s%s) — fired breaches would get no "
             "autopsy" % (rc, incs or "none",
                          "; PARTIAL.md present" if inc and os.path.isfile(
                              os.path.join(inc, "PARTIAL.md")) else ""))
    try:
        mrc = open(os.path.join(inc, "manifest-verify.rc")).read().strip()
    except OSError:
        mrc = "absent"
    if mrc != "0":
        fail(root, "drill-collect", "collector manifest verify rc=%s" % mrc)
    incident = json.load(open(os.path.join(inc, "incident.json")))
    STATE["incident"] = os.path.basename(inc)
    ok("drill-collect", "incident %s landed, collector-verified" % incs[0])

    # independent manifest re-verify + anchors lint (artifact-based, not rc-trust)
    manifest_rel = incident["manifest"]
    rc, _ = run([sys.executable, os.path.join(root, "scripts", "fidelity-manifest.py"),
                 estate, "--verify", manifest_rel],
                os.path.join(logs, "manifest-verify.out"), 90)
    if rc != 0:
        fail(root, "drill-manifest", "independent H-104 manifest verify failed "
             "rc=%s on %s" % (rc, manifest_rel))
    rc, _ = run([sys.executable,
                 os.path.join(root, "scripts", "incident-anchors-lint.py"),
                 "--collected", os.path.join(inc, "COLLECTED.md"),
                 "--incident", inc, "--root", estate],
                os.path.join(logs, "anchors-lint.out"), 90)
    if rc != 0:
        fail(root, "drill-manifest", "incident anchors lint failed rc=%s "
             "(claims without checkable anchors)" % rc)
    ok("drill-manifest", "manifest re-verified; anchors lint clean")

    # validated row through the consumer's own decision door (drill ledger only)
    bucket = "reflex-drill-%s" % incident["bucket"][:8]
    today = datetime.datetime.fromtimestamp(int(now), UTC).strftime("%Y-%m-%d")
    inc_rel = os.path.relpath(inc, estate)
    rc, out = run([sys.executable, os.path.join(root, "scripts", "reflex-surface"),
                   "detect", "--root", drill,
                   "--scripts-dir", os.path.join(root, "scripts"),
                   "--estate", estate, "--manifest-rel", manifest_rel,
                   "--incident-rel", inc_rel, "--bucket", bucket,
                   "--title", "drill breach autopsy (install self-test)",
                   "--today", today],
                  os.path.join(logs, "detect.out"), 90)
    row = None
    try:
        lines = [l for l in open(os.path.join(drill, "ledger",
                                              "work-ledger.jsonl"),
                                 encoding="utf-8").read().splitlines() if l.strip()]
        row = json.loads(lines[-1]) if lines else None
    except (OSError, ValueError):
        row = None
    errs = D.validate_decision(row) if isinstance(row, dict) else ["no row landed"]
    if rc != 0 or "REFLEX-DETECT" not in out or errs \
            or row.get("type") != "needs-ian" \
            or inc_rel not in row.get("context_pointers", []):
        fail(root, "drill-row", "no validated needs-ian row landed through the "
             "decisions.py door (rc=%s, validate=%s)" % (rc, errs))
    STATE["decision_id"] = row.get("id")
    STATE["bucket"] = bucket
    ok("drill-row", "row %s validated through the decision door" % row.get("id"))

    # escalation at exactly the third simulated surfacing
    def escalations():
        recs = []
        path = os.path.join(drill, "ledger", "incident-records.jsonl")
        if os.path.isfile(path):
            for line in open(path, encoding="utf-8"):
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("kind") == "incident-escalation" \
                        and rec.get("bucket") == bucket:
                    recs.append(rec)
        return recs

    for k in (1, 2, 3):
        rc, _ = run([sys.executable, os.path.join(root, "scripts", "reflex-surface"),
                     "surface", "--root", drill,
                     "--scripts-dir", os.path.join(root, "scripts"),
                     "--bucket", bucket, "--session", str(k),
                     "--at", iso_z(now + 2 * TICK_S + k * 60)],
                    os.path.join(logs, "surface%d.out" % k), 90)
        if rc != 0:
            fail(root, "drill-escalate", "surfacing %d failed rc=%s" % (k, rc))
        esc = escalations()
        if k < N_ESCALATE and esc:
            fail(root, "drill-escalate", "escalated early at surfacing %d "
                 "(edge must be exactly %d)" % (k, N_ESCALATE))
        if k == N_ESCALATE and (len(esc) != 1
                                or esc[0].get("at_surfacing") != N_ESCALATE):
            fail(root, "drill-escalate", "no single escalation at the third "
                 "surfacing (records=%s)" % esc)
    STATE["escalated_at"] = N_ESCALATE
    ok("drill-escalate", "escalation landed at exactly surfacing %d" % N_ESCALATE)

    dur = time.monotonic() - T0
    if dur > BOUND_S:
        fail(root, "selftest-timeout", "self-test took %.1fs > %.0fs bound"
             % (dur, BOUND_S))
    write_report(root, "ok")
    print("SELFTEST-OK checks=%d duration=%.1fs" % (len(CHECKS), dur))
    return 0


if __name__ == "__main__":
    sys.exit(main())
